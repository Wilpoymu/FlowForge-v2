# FlowForge v2 — Variables de entorno
# Renombrar a .env y completar con tus valores

# Flow (Google Labs) API key — se obtiene del tráfico de red de labs.google/fx
FLOW_API_KEY=your_flow_api_key_here

# reCAPTCHA site key — también del tráfico de red de Flow
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
